# Dev: Vite proxies /api to the local catalog API when VITE_API_BASE is empty.
# Production (Netlify): point at your hosted API.

VITE_API_BASE=
VITE_API_PROXY=http://localhost:8787
VITE_ADMIN_TOKEN=change-me-before-sharing

# Production example:
# VITE_API_BASE=https://api.willbound.haleappsllc.com
# VITE_ADMIN_TOKEN=same-as-server-ADMIN_TOKEN
